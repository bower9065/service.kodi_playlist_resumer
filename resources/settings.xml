<?xml version='1.0' encoding='utf-8'?>
<settings version="1">
  <section id="service.kodi_playlist_resumer">
    <category help="" id="resumer" label="32000">
      <group id="1">
        <setting help="32200" id="resumeonstartup" label="32002" type="boolean">
          <level>0</level>
          <default>true</default>
          <control type="toggle" />
        </setting>
        <setting help="32201" id="restorepriority" label="32039" type="string">
          <level>0</level>
          <default>video</default>
          <constraints>
            <options>
              <option label="32040">video</option>
              <option label="32041">music</option>
              <option label="32042">last_used</option>
            </options>
          </constraints>
          <control type="spinner" format="string" />
          <dependencies>
            <dependency type="enable">
              <condition operator="is" setting="resumeonstartup">true</condition>
            </dependency>
            <dependency type="visible">
              <condition operator="is" setting="resumeonstartup">true</condition>
            </dependency>
          </dependencies>
        </setting>
        <setting help="32202" id="resumeifstopped" label="32006" type="boolean">
          <level>0</level>
          <default>false</default>
          <control type="toggle" />
          <dependencies>
            <dependency type="enable">
              <condition operator="is" setting="resumeonstartup">true</condition>
            </dependency>
            <dependency type="visible">
              <condition operator="is" setting="resumeonstartup">true</condition>
            </dependency>
          </dependencies>
        </setting>
        <setting help="32203" id="saveintervalsecs" label="32001" type="integer">
          <level>0</level>
          <default>15</default>
          <constraints>
            <minimum>5</minimum>
            <maximum>600</maximum>
          </constraints>
          <control format="integer" type="slider">
            <popup>false</popup>
          </control>
          <dependencies>
            <dependency type="enable">
              <condition operator="is" setting="resumeonstartup">true</condition>
            </dependency>
            <dependency type="visible">
              <condition operator="is" setting="resumeonstartup">true</condition>
            </dependency>
          </dependencies>
        </setting>
        <setting help="32204" id="resumeoffset" label="32005" type="integer">
          <level>0</level>
          <default>5</default>
          <constraints>
            <minimum>0</minimum>
            <step>1</step>
            <maximum>60</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
          <dependencies>
            <dependency type="enable">
              <condition operator="is" setting="resumeonstartup">true</condition>
            </dependency>
            <dependency type="visible">
              <condition operator="is" setting="resumeonstartup">true</condition>
            </dependency>
          </dependencies>
        </setting>
        <setting help="32205" id="autoplayrandom" label="32003" type="boolean">
          <level>0</level>
          <default>true</default>
          <control type="toggle" />
        </setting>
        <setting help="32206" id="resume_delay" label="32004" type="integer">
          <level>0</level>
          <default>12</default>
          <constraints>
            <minimum>7</minimum>
            <step>1</step>
            <maximum>60</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
          <dependencies>
            <dependency type="enable">
              <or>
                <condition operator="is" setting="resumeonstartup">true</condition>
                <condition operator="is" setting="autoplayrandom">true</condition>
              </or>
            </dependency>
            <dependency type="visible">
              <or>
                <condition operator="is" setting="resumeonstartup">true</condition>
                <condition operator="is" setting="autoplayrandom">true</condition>
              </or>
            </dependency>
          </dependencies>
        </setting>
      </group>
    </category>
